{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hug0x0/hyperliquid-asset-catalog/schemas/analytics.schema.json",
  "title": "Hyperliquid market analytics",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["schema_version", "instrument_id", "symbol", "dex", "asset_class", "observations", "liquidity_score", "data_quality_score", "retrieved_at"],
    "properties": {
      "schema_version": {"const": "1.0"},
      "instrument_id": {"type": "string"},
      "symbol": {"type": "string"},
      "dex": {"type": "string"},
      "observations": {"type": "integer", "minimum": 0},
      "liquidity_score": {"type": "number", "minimum": 0, "maximum": 100},
      "data_quality_score": {"type": "number", "minimum": 0, "maximum": 100},
      "retrieved_at": {"type": "string"}
    }
  }
}
