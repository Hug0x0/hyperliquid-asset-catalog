{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark methodology",
  "type": "object",
  "required": ["id", "version", "eligibility", "weighting", "max_weight", "constituent_buffer", "rebalance_every_sessions"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "eligibility": {"type": "object"},
    "weighting": {"enum": ["equal", "liquidity", "inverse_volatility"]},
    "max_weight": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1},
    "constituent_buffer": {"type": "integer", "minimum": 0},
    "rebalance_every_sessions": {"type": "integer", "minimum": 1}
  }
}
