# Optional, public read-only endpoint override. No wallet or API credentials are required.
HL_CATALOG_API_URL=https://api.hyperliquid.xyz/info
HL_CATALOG_OUTPUT_DIR=output
HL_CATALOG_CACHE_DIR=.cache/hl_asset_catalog
HL_CATALOG_TIMEOUT=20
HL_CATALOG_MAX_RETRIES=4
HL_CATALOG_CONCURRENCY=4
HL_CATALOG_WEIGHTED_REQUEST_BUDGET=1000
HL_CATALOG_ANALYTICS_JITTER_MAX=0.05
HL_CATALOG_API_CACHE_TTL=60
HL_CATALOG_DOC_CACHE_TTL=86400
HL_CATALOG_USER_AGENT=hl-asset-catalog/0.1 (+https://github.com/Hug0x0/hyperliquid-asset-catalog)
